void norm(){
  
  /*
  How it should work:
  Green for 20 secs, Yellow for 5 secs, Red for 10 secs, then reset.
  Then reset tick time.
  If interrupted by disco function, time will be set to a few seconds before yellow after function is done.
  */

  Serial.print("tick: ");
  Serial.println(tick);

  if (tick <= 20){ //if time <= 20 secs
    //turn green
    analogWrite(redPin, 0);
    analogWrite(yellowPin, 0);
    analogWrite(greenPin, 168);
    Serial.println("green");
  } else if (tick <= 25){ //if time <= 25 secs
    //turn yellow
    digitalWrite(redPin, 0);
    digitalWrite(yellowPin, 168);
    digitalWrite(greenPin, 0);
    Serial.println("yellow");
  } else if (tick <= 30){ //if time <= 30 secs
    //turn red
    digitalWrite(redPin, 168);
    digitalWrite(yellowPin, 0);
    digitalWrite(greenPin, 0);
    Serial.println("Red");
  } else if (tick <= 40){
    tick = 0;
  }

}


